# Copiar estos nombres en Vercel > Settings > Environment Variables.
# Ninguna es obligatoria para la versión de prueba.

# Clave para entrar al panel /admin (si no está, es "crisanta-prueba")
ADMIN_CLAVE=

# Base de datos de stock (Supabase > Project Settings > API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Pago (Tus integraciones > Credenciales). Si no está, el pago es simulado.
MP_ACCESS_TOKEN=

# Dirección final del sitio, por ejemplo https://crisanta.com.ar
SITE_URL=

# WhatsApp de la marca, sin + ni espacios (ej: 5493411234567)
NEXT_PUBLIC_WHATSAPP=

# Clave para que el futuro bot de WhatsApp pueda leer y cambiar stock
STOCK_API_CLAVE=
